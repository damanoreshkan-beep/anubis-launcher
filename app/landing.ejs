<div id="landingContainer" style="display: none;">
    <!--
      Update toast — lives in the top-left corner so it never collides
      with the avatar/settings pill on the right. Renderer toggles
      `display: none / block` via #updateBanner.
    -->
    <div id="updateBanner" style="display: none;">
        <div class="updateBannerInner">
            <svg class="updateBannerIcon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12a9 9 0 1 1-3.5-7.13"/>
                <polyline points="21 4 21 10 15 10"/>
            </svg>
            <span class="updateBannerText">
                <strong><%- lang('landing.updateBannerTitle') %></strong>
                <em id="updateBannerVersion"></em>
            </span>
            <button id="updateBannerInstall" class="updateBannerInstall"><%- lang('landing.updateBannerInstall') %></button>
            <button id="updateBannerDismiss" class="updateBannerDismiss" aria-label="dismiss">&times;</button>
        </div>
    </div>

    <!--
      Background — single full-bleed image. Everything previously here
      (particle field, twinkling stars, glow orbs) was decorative noise
      that competed with the actual focal point (logo + PLAY button).
      One bold image carries the atmosphere by itself.
    -->
    <div class="lp-bg" aria-hidden="true">
        <img class="lp-bg-img" src="assets/images/site/landing-bg.jpg" alt=""/>
        <div class="lp-bg-vignette"></div>
    </div>

    <!--
      Top-right account capsule. Same DOM as before so the renderer
      keeps working — only the surrounding chrome has been simplified.
    -->
    <div class="lp-top-right">
        <div class="lp-user glass">
            <button id="avatarPill" class="lp-user-action" aria-label="Settings — Skin">
                <span id="user_text"><%- lang('landing.usernamePlaceholder') %></span>
                <span id="avatarContainer" aria-hidden="true">
                    <span id="avatarOverlay"><%- lang('landing.usernameEditButton') %></span>
                </span>
            </button>
            <span class="lp-user-sep" aria-hidden="true"></span>
            <button id="settingsPill" class="lp-user-action" aria-label="Settings">
                <svg class="settings-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <circle cx="12" cy="12" r="3"/>
                    <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                </svg>
                <span class="settings-label"><%- lang('landing.settingsTooltip') %></span>
            </button>
        </div>
    </div>

    <!--
      Logo + wordmark intentionally absent from the visible layout —
      user wanted the background art to read on its own without any
      foreground mark competing with it. The seal container is kept
      in DOM (inside .lp-hidden-renderer-shims below) because
      uicore.js binds the "update available" tooltip click handler
      to #image_seal_container.
    -->

    <!-- Bottom-right: PLAY button + progress strip during download. -->
    <div class="lp-bottom-right">
        <div id="launch_content" class="lp-launch">
            <button id="launch_button" class="lp-play-mega btn-glow">
                <span><%- lang('landing.launchButton') %></span>
            </button>
        </div>
        <div id="launch_details" class="lp-launch-details">
            <div id="launch_details_left">
                <span id="launch_progress_label">0%</span>
            </div>
            <div id="launch_details_right">
                <progress id="launch_progress" value="0" max="100"></progress>
                <span id="launch_details_text" class="bot_label"><%- lang('landing.launchDetails') %></span>
            </div>
        </div>
    </div>

    <!--
      Bottom-left social cluster — large, brand-coloured original
      logos rather than the monochrome glass icons we had before.
      simple-icons SVG paths verbatim.
    -->
    <div class="lp-bottom-social">
        <a href="<%- lang('landing.mediaDiscordURL') %>" class="lp-social-mega lp-discord" id="discordURL" target="_blank" rel="noopener" aria-label="Discord">
            <svg class="mediaSVG" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/></svg>
        </a>
        <a href="<%- lang('landing.mediaTelegramURL') %>" class="lp-social-mega lp-telegram" id="telegramURL" target="_blank" rel="noopener" aria-label="Telegram">
            <svg class="mediaSVG" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
        </a>
        <a href="<%- lang('landing.mediaYouTubeURL') %>" class="lp-social-mega lp-youtube" id="youtubeURL" target="_blank" rel="noopener" aria-label="YouTube">
            <svg class="mediaSVG" viewBox="0 0 24 24" fill="currentColor"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="<%- lang('landing.mediaWebsiteURL') %>" class="lp-social-mega lp-website" id="websiteURL" target="_blank" rel="noopener" aria-label="Website">
            <svg class="mediaSVG" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"/></svg>
        </a>
    </div>

    <!--
      Kept-but-hidden DOM for the renderer:
        · server status / players online — Mojang dot — not part of
          the simplified landing. Renderer still updates these on a
          timer; they're invisible to the user.
        · server selection — single-server launcher, no UI for it.
    -->
    <div class="lp-hidden-renderer-shims" aria-hidden="true" hidden>
        <!-- Update-tooltip mount point — clicked when an update is
             ready. Image inside is irrelevant; we just need the
             container element to exist. -->
        <div id="image_seal_container">
            <img id="image_seal" src="assets/images/site/logo.jpg" alt=""/>
            <div id="updateAvailableTooltip"><%- lang('landing.updateAvailableTooltip') %></div>
        </div>
        <span class="bot_label" id="landingPlayerLabel"></span>
        <span id="player_count"></span>
        <div id="mojangStatusWrapper">
            <span id="mojang_status_icon"></span>
            <div id="mojangStatusTooltip">
                <div id="mojangStatusTooltipTitle"></div>
                <div id="mojangStatusEssentialContainer"></div>
                <div id="mojangStatusNEContainer">
                    <div class="mojangStatusNEBar"></div>
                    <div id="mojangStatusNETitle"></div>
                    <div class="mojangStatusNEBar"></div>
                </div>
                <div id="mojangStatusNonEssentialContainer"></div>
            </div>
        </div>
        <button id="server_selection_button"></button>
    </div>

    <script src="./assets/js/scripts/landing.js"></script>
</div>
