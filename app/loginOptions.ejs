<div id="loginOptionsContainer" style="display: none;">
    <div id="loginOptionsContent">
        <div class="loginOptionsMainContent">
            <img class="loginOptionsLogo" src="assets/images/site/logo.jpg" alt="" />
            <h2><%- lang('loginOptions.loginOptionsTitle') %></h2>

            <div id="migrationBanner" class="hidden">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/>
                </svg>
                <div class="migrationBannerText">
                    <strong><%- lang('loginOptions.migrationTitle') %></strong>
                    <span><%- lang('loginOptions.migrationBody') %> <em id="migrationNickValue"></em></span>
                </div>
            </div>

            <div id="loginOptionsTabs">
                <button id="loginTabSignIn" class="loginOptionsTab" data-tab="signin"><%- lang('loginOptions.tabSignIn') %></button>
                <button id="loginTabSignUp" class="loginOptionsTab" data-tab="signup"><%- lang('loginOptions.tabSignUp') %></button>
            </div>

            <form id="signInPane" class="loginPane">
                <label class="loginField">
                    <span><%- lang('loginOptions.emailLabel') %></span>
                    <input id="signInEmail" type="email" required autocomplete="email" placeholder="you@example.com">
                </label>
                <label class="loginField">
                    <span><%- lang('loginOptions.passwordLabel') %></span>
                    <input id="signInPassword" type="password" required minlength="6" autocomplete="current-password" placeholder="••••••">
                </label>
                <p id="signInError" class="loginFieldError"></p>
                <button type="submit" id="signInSubmit" class="loginPrimaryButton">
                    <span><%- lang('loginOptions.signInSubmit') %></span>
                </button>
                <button type="button" id="signInForgot" class="loginLinkButton"><%- lang('loginOptions.forgotPassword') %></button>
            </form>

            <form id="signUpPane" class="loginPane" style="display: none;">
                <label class="loginField">
                    <span><%- lang('loginOptions.emailLabel') %></span>
                    <input id="signUpEmail" type="email" required autocomplete="email" placeholder="you@example.com">
                </label>
                <label class="loginField">
                    <span><%- lang('loginOptions.passwordLabel') %></span>
                    <input id="signUpPassword" type="password" required minlength="6" autocomplete="new-password" placeholder="6+">
                </label>
                <label class="loginField">
                    <span><%- lang('loginOptions.nicknameLabel') %></span>
                    <input id="signUpNick" type="text" required minlength="3" maxlength="16" pattern="[a-zA-Z0-9_]{3,16}" autocomplete="off" placeholder="Steve_99">
                </label>
                <p id="signUpError" class="loginFieldError"></p>
                <button type="submit" id="signUpSubmit" class="loginPrimaryButton">
                    <span><%- lang('loginOptions.signUpSubmit') %></span>
                </button>
            </form>

            <div class="loginDivider">
                <span><%- lang('loginOptions.orDivider') %></span>
            </div>

            <button type="button" id="signInDiscord" class="loginDiscordButton">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03z"/></svg>
                <span><%- lang('loginOptions.signInDiscord') %></span>
            </button>

            <div id="loginOptionCancelContainer" style="display: none;">
                <button id="loginOptionCancelButton"><%- lang('loginOptions.cancelButton') %></button>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
