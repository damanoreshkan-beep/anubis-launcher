<div id="loginOptionsContainer" style="display: none;">
    <div id="loginOptionsContent">
        <div class="loginOptionsMainContent">
            <img class="loginOptionsLogo" src="assets/images/site/logo.jpg" alt="" />

            <div id="migrationBanner" class="hidden">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 9v2m0 4h.01M5.07 19h13.86c1.54 0 2.5-1.67 1.73-3L13.73 4a2 2 0 00-3.46 0L3.34 16c-.77 1.33.19 3 1.73 3z"/>
                </svg>
                <div class="migrationBannerText">
                    <strong><%- lang('loginOptions.migrationTitle') %></strong>
                    <span><%- lang('loginOptions.migrationBody') %> <em id="migrationNickValue"></em></span>
                </div>
            </div>

            <!-- Single auth widget shared with the website. Renders the same
                 stack-nav (start → email → forgot) UI; the launcher just
                 listens for `anubis-auth-success` to finalise the offline
                 account and switch view. -->
            <div id="authWidgetMount"></div>

            <div id="loginOptionCancelContainer" style="display: none;">
                <button id="loginOptionCancelButton"><%- lang('loginOptions.cancelButton') %></button>
            </div>
        </div>
    </div>
    <script src="./assets/js/scripts/loginOptions.js"></script>
</div>
